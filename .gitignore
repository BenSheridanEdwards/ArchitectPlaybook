# Editor and operating-system noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
__pycache__/
*.py[cod]

# Local Claude Code state created when this playbook is itself audited
.claude/settings.local.json
.claude/skills/*
!.claude/skills/install-architect-playbook-globally/
!.claude/skills/install-architect-playbook-globally/**
graphify-out/
.architect-audits/*
!.architect-audits/pre-audit-setup/
!.architect-audits/pre-audit-setup/**
!.architect-audits/quality-gates-audit/
!.architect-audits/quality-gates-audit/**
!.architect-audits/testing-audit/
!.architect-audits/testing-audit/**
!.architect-audits/architecture-audit/
!.architect-audits/architecture-audit/**
# Staged audit runs are local working state, never committed
.architect-audits/**/.staging/

# Node and package-manager output (in case a future skill produces any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and coverage output
dist/
build/
coverage/

# Claude Code agent tooling (GitNexus index, Graphify output, local settings)
.gitnexus/
!.claude/skills/gitnexus/
!.claude/skills/gitnexus/**

# Git worktrees created inside this repository by agents and maintainers
.worktrees/
.claude/worktrees/

# Evaluation results from claude plugin eval
evals/results/
